# ----- W&B credentials (used for BOTH Weave tracing and Inference) -----
# Get your API key from https://wandb.ai/authorize
WANDB_API_KEY=wandb_v1_YOUR_API_KEY_HERE

# Your W&B entity/workspace name
WANDB_ENTITY=your-entity-name

# Your W&B project name
WANDB_PROJECT=your-project-name

# ----- W&B Inference (OpenAI-compatible) -----
WB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1

# Live inference (real W&B key present). Set to 1 to force the offline mock.
USE_MOCK_INFERENCE=0

# ----- Cost governor -----
ENGAGEMENT_TOKEN_BUDGET=200000
INFERENCE_CONCURRENCY=4

# Naive intake fuels the compliance trap. Set to 0 for a diligent intake.
INTAKE_NAIVE=1
